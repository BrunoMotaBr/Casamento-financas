# ============================================
# Configurações do Banco de Dados PostgreSQL
# ============================================
# Copie este arquivo para .env e preencha com seus dados

# Opção 1: String de conexão completa (recomendado para produção)
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/casamento_db

# Opção 2: Variáveis separadas (para desenvolvimento local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=casamento_db
DB_USER=seu_usuario
DB_PASSWORD=sua_senha

# Porta do servidor Node.js
PORT=3000

# Ambiente (development | production)
NODE_ENV=development
